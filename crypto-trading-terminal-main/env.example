# 🐼 Crypto Trading Terminal - Environment Configuration
# Copy this file to .env and update with your actual values

# ===========================================
# HYPERLIQUID API CONFIGURATION
# ===========================================

# Testnet URLs (Default - Safe for testing)
HYPERLIQUID_TESTNET_RPC_URL=https://api.hyperliquid-testnet.xyz/info
HYPERLIQUID_MAINNET_RPC_URL=https://api.hyperliquid.xyz/info

# ===========================================
# WALLET CONFIGURATION
# ===========================================

# IMPORTANT: Replace these with your actual wallet details
# For testnet, you can use any wallet address and private key
# For mainnet, use your real trading wallet credentials

# Wallet Address (Your Hyperliquid wallet address)
WALLET_ADDRESS=0x1234567890abcdef1234567890abcdef12345678

# Private Key (Your wallet's private key - KEEP THIS SECRET!)
PRIVATE_KEY=your_private_key_here_keep_this_secret

# ===========================================
# TRADING PARAMETERS
# ===========================================

# Trading Budget (Total amount available for trading)
TRADING_BUDGET=200.0

# Position Size (Amount per position)
POSITION_SIZE=10.0

# RSI Threshold (Signal sensitivity - lower = more signals)
RSI_THRESHOLD=18

# Cooldown Period (Seconds between trades)
COOLDOWN_SECONDS=60

# ===========================================
# DASHBOARD CONFIGURATION
# ===========================================

# Host and Port for the web interface
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8050

# Update interval for real-time data (seconds)
UPDATE_INTERVAL_SECONDS=60

# Debug mode (set to false for production)
DASHBOARD_DEBUG=false

# ===========================================
# ADVANCED SETTINGS
# ===========================================

# Maximum number of coins to track simultaneously
MAX_COINS=50

# Database file path
DATABASE_PATH=terminal/data/analytics.db

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ===========================================
# SAMPLE TESTNET CREDENTIALS
# ===========================================
# These are example testnet credentials for immediate testing
# Replace with your own testnet wallet for security

# Sample Testnet Wallet (DO NOT USE IN PRODUCTION)
# WALLET_ADDRESS=0x742d35Cc6634C0532925a3b8D6Ac6E2f60c5C8f5
# PRIVATE_KEY=0x1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef

# ===========================================
# SECURITY NOTES
# ===========================================
# 1. Never commit your .env file to version control
# 2. Use testnet for development and testing
# 3. Keep your private keys secure and never share them
# 4. Start with small amounts when testing on mainnet
# 5. Regularly backup your wallet and configuration

# ===========================================
# QUICK START INSTRUCTIONS
# ===========================================
# 1. Copy this file: cp env.example .env
# 2. Edit .env with your wallet details
# 3. Run: ./setup.sh
# 4. Start: ./start.sh
# 5. Open: http://localhost:8050
