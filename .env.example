# Lighter.xyz Configuration
USE_LIGHTER_MAINNET=false  # Set to 'true' for mainnet

# Testnet Configuration
LIGHTER_TESTNET_URL=https://lighter-api-testnet.publicnode.com
LIGHTER_TESTNET_PRIVATE_KEY=your_testnet_private_key_here

# Mainnet Configuration
LIGHTER_MAINNET_URL=https://api.lighter.xyz
LIGHTER_MAINNET_PRIVATE_KEY=your_mainnet_private_key_here

# Trading Settings
LIGHTER_LIVE_TRADING=false  # Set to 'true' to enable live trading
LIGHTER_POSITION_SIZE=500  # Notional size in USD
LIGHTER_TP_PCT=0.001327  # Take profit % (+$150/$113k)
LIGHTER_SL_PCT=0.001062  # Stop loss % (-$120/$113k)
